#!/usr/bin/env python3
"""Builds GT3 Revisited for your Apple TV from your own disc image: the entry point that port.json names.

    tools/tvos/port check     [options]   what this Mac is missing, and whether the disc image looks right
    tools/tvos/port prepare   [options]   checks the disc image (once per image: it's remembered by its
                                          path, size and modification time)
    tools/tvos/port build     [options]   prepares if needed, then builds and signs gt3r.app with the disc
                                          image inside it
    tools/tvos/port install --device D    installs the built app on the Apple TV (it never starts it)
    tools/tvos/port installed --device D  what's on the Apple TV: version, build
    tools/tvos/port clean     [options]   removes what this script made in the work folder

Options, each also a field of --context:
    --platform tvos    the only platform (accepted so the installer can always pass it)
    --disc PATH        your disc image: .iso or .chd
    --team ID          the Apple team that signs the app (default: one signed in to Xcode, paid first)
    --bundle-id ID     default: com.gt3revisited.<team ID>
    --device ID        the Apple TV (devicectl's identifier, its UDID or its name)
    --work-dir DIR     where everything goes (default: build/port)
    --context FILE     the same as JSON: {"team", "bundleId", "device", "workDir", "inputs": {"disc"}}
    --json             one JSON event per line on stdout; the tools' own output goes to stderr

GT3 Revisited Installer.app runs it with --json, from the release tag it checked out. Only Python 3's
standard library is used (run it as /usr/bin/python3 -I). The disc image is read where it is and copied
only into the built app, which is for your own Apple TV: nothing from it goes into the source tree.
"""
import argparse
import datetime
import json
import os
import platform
import plistlib
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import List, Optional

ROOT = Path(__file__).resolve().parents[2]
IMAGE_TYPES = {'.iso', '.chd'}
CONFIGURATION = 'RelWithDebInfo'
TARGET = 'gt3r'
SDK = 'appletvos'
# The releases the engine knows (src/disc/disc.cpp), by the boot file SYSTEM.CNF names.
KNOWN_SERIALS = {
    'PBPX_955.03': 'NTSC-U',  # 1.10
    'SCUS_971.02': 'NTSC-U',  # 1.00
    'SCES_502.94': 'PAL',
    'SCPS_150.09': 'NTSC-J',
}
MIN_XCODE = (27, 0)
MIN_CMAKE = (3, 21)
MIN_PYTHON = (3, 9)

JSON = False


class Failure(Exception):
    def __init__(self, code: str, message: str, fix: str = ''):
        super().__init__(message)
        self.code, self.message, self.fix = code, message, fix


# Events --------------------------------------------------------------------------------------------

def emit(event: str, **fields) -> None:
    if JSON:
        print(json.dumps({'event': event, **fields}), flush=True)
        return
    if event == 'stage':
        print(f"==> {fields['label']}", flush=True)
    elif event == 'check':
        mark = 'ok ' if fields['ok'] else 'NO '
        print(f"{mark} {fields['label']}: {fields['detail']}", flush=True)
        if not fields['ok'] and fields.get('fix'):
            print(f"    {fields['fix']}", flush=True)
    elif event == 'error':
        print(f"error: {fields['message']}", file=sys.stderr, flush=True)
        if fields.get('fix'):
            print(f"  {fields['fix']}", file=sys.stderr, flush=True)
    elif event == 'warning':
        print(f"warning: {fields['message']}", flush=True)
    elif event == 'result':
        print(f"Built {fields['app']} ({fields['version']}, {fields['sizeBytes'] / 1e9:.2f} GB)", flush=True)
        if fields.get('expires'):
            print(f"It opens until {fields['expires'][:10]}; building and installing again renews it.", flush=True)
    elif event == 'installed':
        if fields.get('present'):
            print(f"Installed: {fields.get('bundleId', '')} {fields.get('version', '')} "
                  f"(build {fields.get('build', '')})", flush=True)
        else:
            print(f"Not installed: {fields.get('bundleId', '')}", flush=True)
    elif event in ('note', 'prepared'):
        print(fields.get('message') or f"Disc image ready: {fields.get('disc', '')}", flush=True)


def stage(name: str, label: str) -> None:
    emit('stage', id=name, label=label)


def run(argv: list, **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run([str(a) for a in argv], capture_output=True, text=True, **kwargs)


def stream(argv: list, cwd: Optional[Path] = None, on_line=None) -> int:
    """Runs a tool with its output passed to stderr (stdout is the events' in --json mode)."""
    process = subprocess.Popen([str(a) for a in argv], cwd=cwd, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, text=True, errors='replace')
    for line in process.stdout:
        sys.stderr.write(line)
        if on_line:
            on_line(line.rstrip('\n'))
    return process.wait()


# Context -------------------------------------------------------------------------------------------

class Context:
    def __init__(self, args):
        data = {}
        if args.context:
            data = json.loads(Path(args.context).expanduser().read_text())
        inputs = data.get('inputs') or {}
        self.disc = args.disc or inputs.get('disc')
        self.team = args.team or data.get('team') or ''
        self.bundle_id = args.bundle_id or data.get('bundleId') or ''
        self.device = getattr(args, 'device', None) or data.get('device') or ''
        chosen = args.platform or data.get('platform') or 'tvos'
        if chosen != 'tvos':
            raise Failure('platform', f'GT3 Revisited is built for the Apple TV only, not {chosen}.',
                          'Pass --platform tvos.')
        work = args.work_dir or data.get('workDir') or str(ROOT / 'build' / 'port')
        self.work = Path(work).expanduser().resolve()

    def signing(self) -> None:
        """Fills in the team and bundle ID. A free team works, but its apps open for 7 days."""
        teams = xcode_teams()
        if not self.team:
            if not teams:
                raise Failure('xcode-account', 'No Apple ID is signed in to Xcode.',
                              'Sign in under Xcode > Settings > Accounts (a free Apple ID works), or pass --team.')
            chosen = next((t for t in teams if not t['free']), teams[0])
            self.team = chosen['id']
        known = next((t for t in teams if t['id'] == self.team), None)
        if teams and not known:
            raise Failure('xcode-account', f"Team {self.team} isn't signed in to Xcode.",
                          'Sign in to its Apple ID under Xcode > Settings > Accounts.')
        if known and known['free']:
            emit('warning', code='free-team',
                 message=f"{known['name'] or self.team} is a free personal team: the app will open for 7 days, "
                         "then needs installing again.")
        if not self.bundle_id:
            self.bundle_id = f'com.gt3revisited.{self.team.lower()}'


def xcode_teams() -> List[dict]:
    """The teams of the Apple IDs signed in to Xcode (Settings > Accounts)."""
    exported = run(['defaults', 'export', 'com.apple.dt.Xcode', '-'])
    try:
        prefs = plistlib.loads(exported.stdout.encode()) if exported.returncode == 0 else {}
    except Exception:
        prefs = {}
    teams = []
    for account in prefs.get('IDEProvisioningTeamByIdentifier', {}).values():
        for team in account:
            if team.get('teamID') and all(t['id'] != team['teamID'] for t in teams):
                teams.append({'id': team['teamID'], 'name': team.get('teamName', ''),
                              'free': bool(team.get('isFreeProvisioningTeam'))})
    return teams


# The disc ------------------------------------------------------------------------------------------

def source_of(ctx: Context) -> Path:
    if not ctx.disc:
        raise Failure('disc-missing', 'No disc image given.', 'Pass --disc with your .iso or .chd.')
    source = Path(ctx.disc).expanduser().resolve()
    if not source.is_file():
        raise Failure('disc-missing', f'{source} is not a file.')
    if source.suffix.lower() not in IMAGE_TYPES:
        raise Failure('disc-unsupported', f'{source.name} is not a disc image GT3 Revisited reads.',
                      'Use a .iso or .chd made from your own copy of the game.')
    return source


SECTOR = 2048


def iso_root_file(f, name: str) -> Optional[bytes]:
    """A file from an ISO 9660 image's root directory (None if it isn't there)."""
    f.seek(16 * SECTOR)
    pvd = f.read(SECTOR)
    if pvd[0:1] != b'\x01' or pvd[1:6] != b'CD001':
        return None
    root = pvd[156:156 + 34]
    extent, size = int.from_bytes(root[2:6], 'little'), int.from_bytes(root[10:14], 'little')
    f.seek(extent * SECTOR)
    directory = f.read(min(size, 64 * SECTOR))
    at = 0
    while at < len(directory):
        length = directory[at]
        if length == 0:  # records don't cross sectors: go on at the next one
            at = (at // SECTOR + 1) * SECTOR
            continue
        record = directory[at:at + length]
        ident = record[33:33 + record[32]].decode('ascii', 'replace').split(';')[0]
        if ident.upper() == name.upper():
            f.seek(int.from_bytes(record[2:6], 'little') * SECTOR)
            return f.read(min(int.from_bytes(record[10:14], 'little'), 4096))
        at += length
    return None


def disc_info(source: Path) -> dict:
    """What the image says it is: its boot file (the serial) from SYSTEM.CNF. A .chd isn't read here (the
    game reads it when it starts)."""
    if source.suffix.lower() == '.chd':
        with source.open('rb') as f:
            if f.read(8) != b'MComprHD':
                raise Failure('disc-unreadable', f"{source.name} isn't a CHD image.",
                              'Make the image again from your own disc.')
        return {'serial': None, 'region': None}
    try:
        with source.open('rb') as f:
            cnf = iso_root_file(f, 'SYSTEM.CNF')
    except OSError as error:
        raise Failure('disc-unreadable', f"Couldn't read {source.name}: {error.strerror}.",
                      'Check the file is on a disk this Mac can read, and that the installer may open it.')
    if cnf is None:
        raise Failure('disc-unreadable', f"{source.name} isn't a PlayStation 2 disc image (no SYSTEM.CNF).",
                      'Make the image again from your own disc.')
    found = re.search(rb'BOOT2\s*=\s*cdrom0:\\?([A-Z]{4}_\d{3}\.\d{2})', cnf)
    serial = found.group(1).decode() if found else None
    return {'serial': serial, 'region': KNOWN_SERIALS.get(serial or '')}


def stamp_of(source: Path) -> dict:
    status = source.stat()
    return {'source': str(source), 'size': status.st_size, 'mtime': int(status.st_mtime)}


def prepare(ctx: Context) -> dict:
    """Checks the disc image. Does nothing when the same image was checked before."""
    record_path = ctx.work / 'prepared.json'
    source = source_of(ctx)
    try:
        record = json.loads(record_path.read_text())
    except (OSError, ValueError):
        record = None
    if record and record.get('stamp') == stamp_of(source):
        emit('note', message='The disc image was checked before.')
        return record

    stage('disc', 'Checking your disc image')
    info = disc_info(source)
    if source.suffix.lower() == '.iso' and not info['region']:
        if info['serial']:
            emit('warning', code='disc-unknown',
                 message=f"{source.name} is {info['serial']}, which isn't a release GT3 Revisited has been tested "
                         "with. It may still work (modified discs are read too).")
        else:
            raise Failure('wrong-game', f"{source.name} doesn't look like Gran Turismo 3 A-Spec.",
                          'Use an image of your own Gran Turismo 3 A-Spec disc.')
    record = {'stamp': stamp_of(source), 'disc': str(source), **info}
    ctx.work.mkdir(parents=True, exist_ok=True)
    record_path.write_text(json.dumps(record, indent=2) + '\n')
    emit('prepared', disc=str(source), serial=info['serial'], region=info['region'])
    return record


# The version ---------------------------------------------------------------------------------------

def source_version() -> dict:
    """The release being built: the tag at HEAD (v1.2.0 -> 1.2.0), else port.json's version, and the
    commit. Only an exact tag counts, so the upstream game's own tags (v0.x) are never taken for ours."""
    commit = run(['git', '-C', ROOT, 'rev-parse', '--short', 'HEAD'])
    tag = run(['git', '-C', ROOT, 'describe', '--tags', '--exact-match', 'HEAD'])
    found = re.fullmatch(r'v?(\d+\.\d+\.\d+(?:-[0-9A-Za-z.]+)?)', tag.stdout.strip()) if tag.returncode == 0 else None
    if found and not found.group(1).startswith('0.'):
        version = found.group(1)
    else:
        version = json.loads((ROOT / 'port.json').read_text())['version']
    return {'version': version, 'commit': commit.stdout.strip() if commit.returncode == 0 else ''}


# Check ---------------------------------------------------------------------------------------------

def version_of(text: str) -> tuple:
    found = re.search(r'(\d+)\.(\d+)', text)
    return (int(found.group(1)), int(found.group(2))) if found else (0, 0)


def cmd_check(ctx: Context) -> int:
    results = []

    def check(name: str, label: str, ok: bool, detail: str, fix: str = '') -> None:
        results.append(ok)
        emit('check', id=name, label=label, ok=bool(ok), detail=detail, fix='' if ok else fix)

    check('mac', 'Apple silicon Mac', platform.machine() == 'arm64', platform.machine(),
          'The installer builds on Apple silicon Macs only.')
    check('python', 'Python 3.9 or later', sys.version_info[:2] >= MIN_PYTHON, platform.python_version(),
          'Xcode includes it: install Xcode, then open it once.')

    selected = run(['xcode-select', '-p'])
    developer = selected.stdout.strip()
    xcode = run(['xcodebuild', '-version']) if shutil.which('xcodebuild') else None
    xcode_line = xcode.stdout.splitlines()[0] if xcode and xcode.returncode == 0 and xcode.stdout else ''
    ok = version_of(xcode_line) >= MIN_XCODE and 'CommandLineTools' not in developer
    check('xcode', 'Xcode 27 or later', ok, xcode_line or developer or 'not found',
          'Install Xcode from the App Store, open it once, then: sudo xcode-select -s /Applications/Xcode.app')

    sdks = run(['xcodebuild', '-showsdks', '-json']) if xcode_line else None
    try:
        found = [s['canonicalName'] for s in json.loads(sdks.stdout or '[]')
                 if s.get('platform') == SDK] if sdks and sdks.returncode == 0 else []
    except ValueError:
        found = []
    check('tvos-platform', 'The tvOS platform', bool(found), found[-1] if found else 'not installed',
          'Xcode > Settings > Components, or: xcodebuild -downloadPlatform tvOS')

    cmake = run(['cmake', '--version']) if shutil.which('cmake') else None
    cmake_line = cmake.stdout.splitlines()[0] if cmake and cmake.returncode == 0 else ''
    check('cmake', 'CMake 3.21 or later', version_of(cmake_line) >= MIN_CMAKE, cmake_line or 'not found',
          'Download CMake from cmake.org and drag CMake.app to Applications, or: brew install cmake')

    teams = xcode_teams()
    if ctx.team:
        known = next((t for t in teams if t['id'] == ctx.team), None)
        ok = bool(known)
        detail = (f"{known['name']} ({known['id']})" + (', a free personal team: apps open for 7 days'
                                                        if known['free'] else '')
                  if known else f'{ctx.team} is not signed in to Xcode')
    else:
        chosen = next((t for t in teams if not t['free']), teams[0] if teams else None)
        ok = bool(chosen)
        detail = (f"{chosen['name']} ({chosen['id']})" + (', a free personal team: apps open for 7 days'
                                                          if chosen['free'] else '')
                  if chosen else 'no Apple ID')
    check('account', 'An Apple ID in Xcode', ok, detail,
          'Sign in under Xcode > Settings > Accounts. A free Apple ID works; its apps open for 7 days.')

    if ctx.disc:
        try:
            info = disc_info(source_of(ctx))
            if info['region']:
                check('disc', 'Your disc image', True, f"Gran Turismo 3 A-Spec, {info['region']} ({info['serial']})")
            elif info['serial']:
                check('disc', 'Your disc image', True, f"{info['serial']}: not a tested release, but it may work")
            else:
                check('disc', 'Your disc image', True, 'a CHD image (the game checks it when it starts)')
        except Failure as failure:
            check('disc', 'Your disc image', False, failure.message, failure.fix)

    return 0 if all(results) else 1


# Build ---------------------------------------------------------------------------------------------

# What a failed build said, and what to tell the user. The first that matches wins.
KNOWN_FAILURES = [
    (r'No Accounts?\b|No Account for Team|not signed in',
     'xcode-account', "Xcode isn't signed in to the team's Apple ID.", 'Sign in under Xcode > Settings > Accounts.'),
    (r'has no devices|no devices from which',
     'no-devices', 'The team has no Apple TV registered.',
     "Pair the Apple TV in Xcode's Devices window, and build again with it switched on and awake."),
    (r'(?:App ID|identifier).*(?:is not available|cannot be registered|already in use)',
     'bundle-id-taken', 'The bundle ID {bundle} belongs to another team.', 'Pass a different --bundle-id.'),
    (r'maximum (?:number of )?App IDs|limit of \d+ App IDs',
     'app-id-limit', 'A free team may register only 10 app IDs a week.',
     'Wait a few days, or reuse a bundle ID you registered before with --bundle-id.'),
    (r'[Nn]o (?:signing certificate|certificate)',
     'certificate', 'No development certificate for the team is on this Mac.',
     'Xcode > Settings > Accounts: select the team, Manage Certificates, and add an Apple Development certificate.'),
    (r'No profiles? for',
     'no-profile', "Xcode couldn't make a provisioning profile for the app.",
     'Check the team in Xcode > Settings > Accounts, and that the Apple TV is paired.'),
    (r'GT3R_TVOS_DISC',
     'disc-unreadable', "The build couldn't use the disc image.", 'Choose the disc image again.'),
]


def explain(lines: List[str], ctx: Context) -> Failure:
    errors = [line for line in lines if re.search(r'\berror\b', line, re.IGNORECASE)] or lines[-20:]
    text = '\n'.join(errors)
    for pattern, code, message, fix in KNOWN_FAILURES:
        if re.search(pattern, text):
            return Failure(code, message.format(bundle=ctx.bundle_id), fix.format(bundle=ctx.bundle_id))
    first = next((line.strip() for line in errors if line.strip()), 'the build failed')
    return Failure('build-failed', first[:400], 'The full log has the details.')


def profile_of(app: Path) -> dict:
    decoded = subprocess.run(['security', 'cms', '-D', '-i', str(app / 'embedded.mobileprovision')],
                             capture_output=True)
    if decoded.returncode != 0:
        return {}
    try:
        return plistlib.loads(decoded.stdout)
    except Exception:
        return {}


def devices_listed() -> List[dict]:
    out = Path(os.environ.get('TMPDIR', '/tmp')) / f'gt3r-devices-{os.getpid()}.json'
    run(['xcrun', 'devicectl', 'list', 'devices', '--json-output', out])
    try:
        return json.loads(out.read_text())['result']['devices']
    except (OSError, ValueError, KeyError):
        return []
    finally:
        out.unlink(missing_ok=True)


def hardware_udid(device: str) -> str:
    """The UDID a provisioning profile lists for `device`, which may be devicectl's own identifier (they
    differ), its name or the UDID itself. Empty if devicectl doesn't know it."""
    for entry in devices_listed():
        hardware = entry.get('hardwareProperties', {})
        names = {entry.get('identifier'), hardware.get('udid'), entry.get('deviceProperties', {}).get('name')}
        if device in names:
            return hardware.get('udid', '')
    return ''


def cmd_build(ctx: Context) -> int:
    ctx.signing()
    prepared = prepare(ctx)

    stage('configure', 'Setting up the Xcode project')
    project = ctx.work / 'xcode'
    stamp = source_version()
    # The SDK explicitly: /usr/bin/python3 runs through xcrun, which exports SDKROOT as the macOS SDK,
    # and CMake would take that (and keep it in the cache) over the tvOS default.
    configure = ['cmake', '-S', ROOT, '-B', project, '-G', 'Xcode', '-DCMAKE_SYSTEM_NAME=tvOS',
                 f'-DCMAKE_OSX_SYSROOT={SDK}',
                 '-DCMAKE_OSX_DEPLOYMENT_TARGET=16.0', '-DGT3R_BUILD_TESTS=OFF', '-DGT3R_BUILD_TOOLS=OFF',
                 f'-DGT3R_IOS_TEAM={ctx.team}', f'-DGT3R_IOS_BUNDLE_ID={ctx.bundle_id}',
                 f"-DGT3R_TVOS_DISC={prepared['disc']}",
                 f"-DGT3R_PORT_VERSION={stamp['version']}", f"-DGT3R_PORT_COMMIT={stamp['commit']}"]
    lines: List[str] = []
    if stream(configure, cwd=ROOT, on_line=lines.append) != 0:
        raise explain(lines, ctx)

    stage('compile', 'Compiling the game')
    stats_path = ctx.work / 'build-stats.json'
    try:
        expected = json.loads(stats_path.read_text()).get('steps', 0)
    except (OSError, ValueError):
        expected = 0
    state = {'steps': 0, 'signing': False}
    lines = []

    def on_line(line: str) -> None:
        lines.append(line)
        if len(lines) > 4000:
            del lines[:2000]
        if re.match(r'(CompileC|CompileAssetCatalog\w*|Ld|Libtool|CpResource|ProcessInfoPlistFile) ', line):
            state['steps'] += 1
            if expected and state['steps'] % 10 == 0:
                emit('progress', fraction=round(min(state['steps'] / expected, 0.99), 3))
        # Xcode's line: CodeSign <path>.app (in target 'gt3r' from project '...')
        if line.startswith('CodeSign ') and not state['signing'] and f"target '{TARGET}'" in line:
            state['signing'] = True
            stage('sign', 'Signing the app')

    build = ['cmake', '--build', project, '--config', CONFIGURATION, '--target', TARGET, '--',
             '-allowProvisioningUpdates', '-allowProvisioningDeviceRegistration']
    if stream(build, cwd=ROOT, on_line=on_line) != 0:
        raise explain(lines, ctx)
    if state['steps']:
        stats_path.write_text(json.dumps({'steps': state['steps']}) + '\n')

    app = project / f'{CONFIGURATION}-{SDK}' / f'{TARGET}.app'
    if not (app / 'embedded.mobileprovision').is_file():
        raise Failure('not-signed', "The build finished, but the app isn't signed for a device.",
                      'Check the team in Xcode > Settings > Accounts.')
    profile = profile_of(app)
    expires = profile.get('ExpirationDate')
    devices = profile.get('ProvisionedDevices') or []
    udid = hardware_udid(ctx.device) if ctx.device and devices else ''
    if udid and udid not in devices:
        emit('warning', code='device-not-in-profile',
             message=f"The Apple TV {ctx.device} is not in the app's profile, so it will refuse the install.",
             fix="Pair it in Xcode's Devices window with it awake, then build again.")
    info = plistlib.loads((app / 'Info.plist').read_bytes())
    size = sum(f.stat().st_size for f in app.rglob('*') if f.is_file())
    result = {'app': str(app), 'bundleId': ctx.bundle_id, 'team': ctx.team, 'sizeBytes': size, **stamp,
              'build': info.get('CFBundleVersion'), 'disc': prepared['disc'],
              'expires': expires.replace(tzinfo=datetime.timezone.utc).isoformat() if expires else None,
              'devices': devices}
    (ctx.work / 'result.json').write_text(json.dumps(result, indent=2) + '\n')
    emit('result', **result)
    return 0


def cmd_prepare(ctx: Context) -> int:
    prepare(ctx)
    return 0


def built(ctx: Context) -> dict:
    try:
        return json.loads((ctx.work / 'result.json').read_text())
    except (OSError, ValueError):
        raise Failure('not-built', 'The app has not been built yet.', 'Run: tools/tvos/port build')


def cmd_install(ctx: Context) -> int:
    # The installer installs and stops: the game is started from the Apple TV's Home screen.
    if not ctx.device:
        raise Failure('device-missing', 'No Apple TV given.', 'Pass --device (xcrun devicectl list devices).')
    result = built(ctx)
    gb = result.get('sizeBytes', 0) / 1e9
    stage('install', f'Sending the game to the Apple TV ({gb:.1f} GB: the first time takes about 5 minutes)')
    lines: List[str] = []
    if stream(['xcrun', 'devicectl', 'device', 'install', 'app', '--device', ctx.device, result['app']],
              on_line=lines.append) != 0:
        text = '\n'.join(lines)
        if re.search(r'not (?:included in|in) the provisioning profile|ApplicationVerificationFailed', text):
            raise Failure('device-not-in-profile', "The Apple TV isn't in the app's profile.",
                          "Pair it in Xcode's Devices window with it awake, then build again.")
        raise Failure('install-failed', "The Apple TV didn't take the app.",
                      "Wake it up, check it's paired in Xcode's Devices window and in Developer Mode, and try again.")
    emit('installed', present=True, bundleId=result['bundleId'], version=result['version'], build=result.get('build'),
         commit=result.get('commit', ''), expires=result.get('expires'))
    return 0


def cmd_installed(ctx: Context) -> int:
    """Emits 'installed' with what's on --device: present, version, build."""
    if not ctx.device:
        raise Failure('device-missing', 'No Apple TV given.', 'Pass --device (xcrun devicectl list devices).')
    try:
        result = json.loads((ctx.work / 'result.json').read_text())
        bundle = result['bundleId']
    except (OSError, ValueError, KeyError):
        result = {}
        ctx.signing()
        bundle = ctx.bundle_id
    out = ctx.work / f'apps-{os.getpid()}.json'
    listed = run(['xcrun', 'devicectl', 'device', 'info', 'apps', '--device', ctx.device,
                  '--bundle-id', bundle, '--json-output', out])
    try:
        apps = json.loads(out.read_text())['result']['apps']
    except (OSError, ValueError, KeyError):
        raise Failure('device-unreachable', "Couldn't ask the Apple TV what's installed.",
                      "Wake it up and check it's paired in Xcode's Devices window." + (
                          f" ({listed.stderr.strip().splitlines()[-1]})" if listed.stderr.strip() else ''))
    finally:
        out.unlink(missing_ok=True)
    found = next((a for a in apps if a.get('bundleIdentifier') == bundle), None)
    if not found:
        emit('installed', present=False, bundleId=bundle)
        return 0
    version, build = found.get('version'), found.get('bundleVersion')
    # devicectl gives CFBundleShortVersionString (1.2.0); the build we made knows the full one (1.2.0-rc1).
    if result and str(result.get('build')) == str(build):
        version = result.get('version', version)
    emit('installed', present=True, bundleId=bundle, version=version, build=build)
    return 0


def cmd_clean(ctx: Context) -> int:
    # Only what this script makes: --work-dir may be a folder that holds other things.
    shutil.rmtree(ctx.work / 'xcode', ignore_errors=True)
    for name in ('prepared.json', 'result.json', 'build-stats.json'):
        (ctx.work / name).unlink(missing_ok=True)
    emit('note', message=f'Removed the build from {ctx.work}. Your disc image was not touched.')
    return 0


def main() -> int:
    global JSON
    parser = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    parser.add_argument('command', choices=('check', 'prepare', 'build', 'install', 'installed', 'clean'))
    parser.add_argument('--context')
    parser.add_argument('--disc')
    parser.add_argument('--team')
    parser.add_argument('--bundle-id')
    parser.add_argument('--device')
    parser.add_argument('--platform', choices=('tvos',))
    parser.add_argument('--work-dir')
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args()
    JSON = args.json
    try:
        ctx = Context(args)
        ctx.work.mkdir(parents=True, exist_ok=True)
        return {'check': cmd_check, 'prepare': cmd_prepare, 'build': cmd_build, 'install': cmd_install,
                'installed': cmd_installed, 'clean': cmd_clean}[args.command](ctx)
    except Failure as failure:
        emit('error', code=failure.code, message=failure.message, fix=failure.fix)
        return 1
    except KeyboardInterrupt:
        emit('error', code='cancelled', message='Cancelled.')
        return 130


if __name__ == '__main__':
    sys.exit(main())
