#pragma once

// Generated by CMake from cmake/gt3r_version.h.in: project(GT3Revisited VERSION x.y.z) in
// CMakeLists.txt is the only source of the game's version (plus GT3R_VERSION_SUFFIX for
// local builds). Do not edit the generated copy.

#define GT3R_VERSION "@GT3R_VERSION@"
#define GT3R_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define GT3R_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define GT3R_VERSION_PATCH @PROJECT_VERSION_PATCH@

// The Apple TV port's release version and commit (GT3R_PORT_VERSION in CMakeLists.txt, from
// port.json or the release tag): what the title bar shows on the Apple TV.
#define GT3R_PORT_VERSION "@GT3R_PORT_VERSION@"
#define GT3R_PORT_COMMIT "@GT3R_PORT_COMMIT@"
